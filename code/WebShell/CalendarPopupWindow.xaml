<Window x:Class="PiggyCalendar.WebShell.CalendarPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="小猪日历"
        Icon="Assets/app.ico"
        Width="360" Height="560"
        MinWidth="306" MinHeight="476"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- v0.1.6.30：AllowsTransparency 改为 False，改用系统 Acrylic（DWM 实时模糊）。
         分层窗口（AllowsTransparency=True）拿不到 DWM 的 blur-behind，只有开启普通窗口 +
         CompositionTarget.BackgroundColor=Transparent + DwmExtendFrameIntoClientArea 才能让桌面被模糊填充；
         命中不再依赖 alpha，所以原先“必须留 #01 alpha 才收得到鼠标”的限制只在分层窗口下成立。 -->
    <Grid x:Name="RootGrid">
        <!-- v0.1.6.30：窗口底不再填 alpha=1/255 的黑（v0.1.6.9 时代为“保点击命中”的补丁，只在分层窗口下必要）。
             现在窗口底完全透明，整块客户区交给 DWM 合成，命中由 RootBorder 的 Background=Transparent 保证。 -->
        <Border x:Name="RootBorder"
                Background="Transparent"
                CornerRadius="14"
                Margin="0"
                Padding="0">
            <wv2:WebView2 x:Name="webView" Margin="0" DefaultBackgroundColor="Transparent" />
        </Border>
    </Grid>
</Window>
