<Window x:Class="PiggyCalendar.WebShell.PanelHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="小猪日历"
        Icon="Assets/app.ico"
        Width="640" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        Background="#1B1E24"
        Foreground="#F2F3F5"
        BorderBrush="#2A2E37"
        BorderThickness="1">
    <!-- M0-9~M0-11：设置 / 工具 / 关于通用独立弹窗宿主。
         自绘深色标题栏（与小组件同一深色 token），尺寸固定；WebView2 加载 panel.html?view=...，复用小组件桥实例。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 深色标题栏：标题居左，关闭按钮居右；整条可拖动窗口 -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#23262E"
                BorderBrush="#2A2E37" BorderThickness="0,0,0,1"
                MouseDown="TitleBar_MouseDown">
            <DockPanel>
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="&#10005;"
                        Width="44" Height="38" BorderThickness="0" Background="Transparent"
                        Foreground="#B6BCC9" FontSize="13" Cursor="Hand"
                        Click="CloseBtn_Click" ToolTip="关闭"
                        MouseEnter="CloseBtn_MouseEnter" MouseLeave="CloseBtn_MouseLeave" />
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="#F2F3F5" IsHitTestVisible="False" />
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="webView" Grid.Row="1" DefaultBackgroundColor="#1B1E24" />
    </Grid>
</Window>
